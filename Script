        local healthPercent = hum.Health / hum.MaxHealth
        
        if healthPercent <= 0.30 and healthPercent > 0 and holdingTool and not isEscaping then
            isEscaping = true
            savedPosition = root.CFrame
            local skyPosition = savedPosition + Vector3.new(0, 500, 0)
            hum.PlatformStand = true
            root.Velocity = Vector3.new(0, 0, 0)
            root.CFrame = skyPosition
