-- 🔥 FIX LOGIC: Lưu tool trước khi chết, trả lại sau khi respawn
local savedTools = {}  -- {toolName = toolClone}

local function saveAllTools()
    if not keepGunActive then return end
    savedTools = {}
    local char = LocalPlayer.Character
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    
    local function trySave(container)
        if not container then return end
        for _, item in ipairs(container:GetChildren()) do
            if item:IsA("Tool") then
                -- Dùng :Clone() để lưu bản sao (chỉ giữ 1 lần mỗi tên)
                if not savedTools[item.Name] then
                    local ok, clone = pcall(function() return item:Clone() end)
                    if ok and clone then
                        savedTools[item.Name] = clone
                    end
                end
            end
        end
    end
    
    trySave(backpack)
    trySave(char)
end

local function restoreTools()
    if not keepGunActive then return end
    if next(savedTools) == nil then return end
    
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if not backpack then
        task.wait(0.5)
        backpack = LocalPlayer:FindFirstChild("Backpack")
    end
    if not backpack then return end

    for name, clone in pairs(savedTools) do
        -- Kiểm tra xem đã có tool này chưa
        local exists = backpack:FindFirstChild(name)
        local inChar = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild(name)
        if not exists and not inChar then
            local newTool = clone:Clone()
            newTool.Parent = backpack
        end
    end
end

-- Hook chết: lưu tool trước khi chết (Humanoid.HealthChanged)
local function hookCharacter(char)
    local hum = char:WaitForChild("Humanoid", 5)
    if not hum then return end
    
    hum.HealthChanged:Connect(function(hp)
        if hp <= 0 then
            saveAllTools()
        end
    end)
end

LocalPlayer.CharacterAdded:Connect(function(char)
    -- Restore tools NGAY khi nhân vật mới xuất hiện
    task.wait(1)  -- đợi game load xong backpack
    restoreTools()
    hookCharacter(char)
end)

if LocalPlayer.Character then
    hookCharacter(LocalPlayer.Character)
end

