    local val = tonumber(FOVBox.Text:match("%d+"))
    if val then fovRadius = val FOVBox.Text = "Bán kính vòng tròn FOV: " .. val else FOVBox.Text = "Bán kính vòng tròn FOV: " .. fovRadius end
end)

-- Vẽ vòng tròn FOV quanh tâm màn hình
local fovCircle = Drawing.new("Circle")
fovCircle.Thickness = 1.5
fovCircle.NumSides = 64
fovCircle.Radius = fovRadius
fovCircle.Filled = false
fovCircle.Color = Color3.fromRGB(0, 255, 170)
fovCircle.Visible = false

-- Theo dõi chính xác thời điểm súng ra đạn (Tool.Activated)
local isShooting = false
local connectionTool = nil

local function hookWeapon(char)
    if connectionTool then connectionTool:Disconnect() end
    local tool = char:FindFirstChildOfClass("Tool")
    if tool then
        connectionTool = tool.Activated:Connect(function()
            isShooting = true
            task.delay(0.15, function() -- Giữ ghim trong khoảnh khắc viên đạn bay ra
                isShooting = false
            end)
        end)
    end
end

LocalPlayer.CharacterAdded:Connect(function(char)
    char.ChildAdded:Connect(function(child)
        if child:IsA("Tool") then
            hookWeapon(char)
        end
    end)
end)

if LocalPlayer.Character then
    hookWeapon(LocalPlayer.Character)
    LocalPlayer.Character.ChildAdded:Connect(function(child)
        if child:IsA("Tool") then
            hookWeapon(LocalPlayer.Character)
        end
    end)
end

RunService.RenderStepped:Connect(function()
    pcall(function()
        local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
        
        if aimbotActive then
            fovCircle.Visible = true
            fovCircle.Radius = fovRadius
            fovCircle.Position = screenCenter
        else
            fovCircle.Visible = false
        end

        -- Nếu chưa bật aimbot hoặc súng chưa phát lệnh ra đạn thì không ghim
        if not aimbotActive or not isShooting then return end

        local nearestTarget = nil
        local shortestDist = fovRadius
        
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("Head") and p.Character:FindFirstChild("Humanoid") then
                if p.Character.Humanoid.Health > 0 then
                    local head = p.Character.Head
                    local screenPoint, onScreen = Camera:WorldToViewportPoint(head.Position)
                    if onScreen then
                        local dist = (Vector2.new(screenPoint.X, screenPoint.Y) - screenCenter).Magnitude
                        if dist < shortestDist then
                            shortestDist = dist
                            nearestTarget = head
                        end
                    end
                end
            end
        end
        
        if nearestTarget then
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, nearestTarget.Position)
        end
    end)
end)

