    pcall(function()
        for _, child in ipairs(ShopScroll:GetChildren()) do
            if child:IsA("TextButton") then child:Destroy() end
        end
        
        local foundCount = 0
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("BasePart") or obj:IsA("Model") then
                local nameLower = obj.Name:lower()
                if nameLower:find("shop") or nameLower:find("store") or nameLower:find("vendor") or nameLower:find("merchant") or nameLower:find("door") or nameLower:find("cardoor") or nameLower:find("vehicledoor") then
