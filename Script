        hum.PlatformStand = true
        
        local vel = root:FindFirstChild("TuanMeoFlyVel")
        if not vel then
            vel = Instance.new("BodyVelocity")
            vel.Name = "TuanMeoFlyVel"
            vel.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
            vel.Velocity = Vector3.new(0, 0, 0)
            vel.Parent = root
        end
        
        local gyro = root:FindFirstChild("TuanMeoFlyGyro")
        if not gyro then
            gyro = Instance.new("BodyGyro")
            gyro.Name = "TuanMeoFlyGyro"
            gyro.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
            gyro.CFrame = workspace.CurrentCamera.CFrame
            gyro.Parent = root
        else
            gyro.CFrame = workspace.CurrentCamera.CFrame
        end

        local cam = workspace.CurrentCamera
        local moveDir = Vector3.new(0, 0, 0)
        local look = cam.CFrame.LookVector
        local right = cam.CFrame.RightVector

        if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveDir = moveDir + look end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveDir = moveDir - look end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveDir = moveDir - right end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveDir = moveDir + right end
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) or isGoingUp then moveDir = moveDir + Vector3.new(0, 1, 0) end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) or isGoingDown then moveDir = moveDir - Vector3.new(0, 1, 0) end

        if moveDir.Magnitude > 0 then
            vel.Velocity = moveDir.Unit * 60
        else
            vel.Velocity = Vector3.new(0, 0, 0)
        end
    end)
end)

