-- VÒNG LẶP XỬ LÝ TỐI ƯU HÓA (KHÔNG GIẬT LAG)
--------------------------------------------------------------------------------
local lastSafePos = Vector3.new(0, 50, 0)

-- Vòng lặp vật lý (Noclip & Chống rơi vực)
RunService.Stepped:Connect(function()
    pcall(function()
        local char = LocalPlayer.Character
        if not char then return end
        
        -- Xuyên tường (kể cả nhảy và ngồi)
        if noclipActive then
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") and part.CanCollide then
                    part.CanCollide = false
                end
            end
        end
        
        -- Chống rơi vực
        local root = char:FindFirstChild("HumanoidRootPart")
        if root then
            if root.Position.Y > -30 then
                lastSafePos = root.Position
            elseif antiVoidActive and root.Position.Y < -90 then
                root.CFrame = CFrame.new(lastSafePos + Vector3.new(0, 5, 0))
                root.Velocity = Vector3.zero
            end
        end
    end)
end)

-- Vòng lặp khung hình (Chạy nhanh, Đấm/Bắn nhanh, Aimbot, ESP Tia Line)
RunService.RenderStepped:Connect(function()
    pcall(function()
        local char = LocalPlayer.Character
        local myRoot = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChild("Humanoid")
        
        -- 1. Chạy nhanh
        if speedActive and hum then
            hum.WalkSpeed = customSpeed
        end
        
        -- 2. Đấm nhanh & Bắn nhanh (Tác động trực tiếp lên Animator và Tool)
        if fastAttackActive and hum then
            local animator = hum:FindFirstChildOfClass("Animator")
            if animator then
                for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
                    track:AdjustSpeed(punchMult)
                end
            end
            local tool = char:FindFirstChildOfClass("Tool")
            if tool then
                tool:Activate()
                for _, v in ipairs(tool:GetDescendants()) do
                    if v:IsA("NumberValue") or v:IsA("IntValue") then
                        local nameLower = v.Name:lower()
                        if nameLower:find("cooldown") or nameLower:find("firerate") or nameLower:find("delay") then
                            v.Value = math.max(0.01, v.Value / gunMult)
                        end
                    end
                end
            end
        end
        
        -- 3. Aimbot Ghim Đầu (Hỗ trợ cả giữ chuột phải hoặc đang cầm vũ khí/chạm màn hình)
        if aimbotActive then
            local isAiming = UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) 
                          or UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1)
                          or (char and char:FindFirstChildOfClass("Tool") ~= nil)
            if isAiming then
                local closestHead = nil
                local minDist = math.huge
                local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
                
                for _, p in ipairs(Players:GetPlayers()) do
                    if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("Head") and p.Character:FindFirstChild("Humanoid") then
                        if p.Character.Humanoid.Health > 0 then
                            local head = p.Character.Head
                            local pos, onScreen = Camera:WorldToViewportPoint(head.Position)
                            if onScreen then
                                local dist = (Vector2.new(pos.X, pos.Y) - screenCenter).Magnitude
                                if dist < minDist then
                                    minDist = dist
                                    closestHead = head
                                end
                            end
                        end
                    end
                end
                
                if closestHead then
                    Camera.CFrame = CFrame.new(Camera.CFrame.Position, closestHead.Position)
                end
            end
        end
        
        -- 4. ESP Kiểu Free Fire (Vẽ tia line từ mép trên màn hình + Tên gọn gàng)
        if espActive then
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") and p.Character:FindFirstChild("Head") then
                    local targetChar = p.Character
                    local targetRoot = targetChar.HumanoidRootPart
                    local targetHead = targetChar.Head
                    
                    -- Vẽ tia line bằng Drawing API của Delta X
                    if Drawing then
                        if not espLines[p] then
                            local line = Drawing.new("Line")
                            line.Thickness = 1.5
                            line.Color = Color3.fromRGB(255, 60, 60)
                            line.Transparency = 0.85
                            espLines[p] = line
                        end
                        local screenPos, onScreen = Camera:WorldToViewportPoint(targetHead.Position)
                        if onScreen then
                            espLines[p].From = Vector2.new(Camera.ViewportSize.X / 2, 0) -- Tia kẻ từ đỉnh giữa màn hình kiểu FF
                            espLines[p].To = Vector2.new(screenPos.X, screenPos.Y)
                            espLines[p].Visible = true
                        else
                            espLines[p].Visible = false
                        end
                    end
                    
                    -- Nhãn tên + khoảng cách gọn gàng
                    local tag = targetChar:FindFirstChild("FF_ESP_Tag")
                    if not tag then
                        tag = Instance.new("BillboardGui")
                        tag.Name = "FF_ESP_Tag"
                        tag.AlwaysOnTop = true
                        tag.Size = UDim2.new(0, 140, 0, 30)
                        tag.StudsOffset = Vector3.new(0, 2.2, 0)
                        
                        local lbl = Instance.new("TextLabel", tag)
                        lbl.Name = "Lbl"
                        lbl.BackgroundTransparency = 1
                        lbl.Size = UDim2.new(1, 0, 1, 0)
                        lbl.Font = Enum.Font.GothamBold
                        lbl.TextSize = 11
                        lbl.TextColor3 = Color3.fromRGB(255, 70, 70)
                        lbl.TextStrokeTransparency = 0.2
                        tag.Parent = targetChar
                    end
                    local dist = myRoot and math.floor((targetRoot.Position - myRoot.Position).Magnitude) or 0
                    tag.Lbl.Text = p.Name .. " [" .. dist .. "m]"
                else
                    removeEspForPlayer(p)
                end
            end
        end
    end)
end)

-- Bắn xuyên tường: Tắt va chạm của các vật thể cản trước mặt khi bật
RunService.Heartbeat:Connect(function()
    if not wallbangActive then return end
    pcall(function()
        local rayParams = RaycastParams.new()
        rayParams.FilterDescendantsInstances = {LocalPlayer.Character}
        rayParams.FilterType = Enum.RaycastFilterType.Exclude
        
        local result = workspace:Raycast(Camera.CFrame.Position, Camera.CFrame.LookVector * 300, rayParams)
        if result and result.Instance and result.Instance:IsA("BasePart") then
            -- Nếu không phải nhân vật người chơi thì cho đạn xuyên qua
            if not result.Instance.Parent:FindFirstChild("Humanoid") then
                result.Instance.CanQuery = false
            end
        end
    end)
end)
