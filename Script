local lockedTarget = nil
local MAX_AIM_DIST = 1000
local SMOOTH = 1  -- 1 = ghim cứng (không giật), 0.3 = mượt

-- Tìm head gần tâm màn hình nhất
local function findNearestHead()
    local nearest, shortest = nil, math.huge
    local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local head = p.Character:FindFirstChild("Head")
            local hum = p.Character:FindFirstChildOfClass("Humanoid")
            if head and hum and hum.Health > 0 then
                local dist3D = (head.Position - Camera.CFrame.Position).Magnitude
                if dist3D <= MAX_AIM_DIST then
                    local sp, onScreen = Camera:WorldToViewportPoint(head.Position)
                    if onScreen then
                        local d = (Vector2.new(sp.X, sp.Y) - center).Magnitude
                        if d < shortest then
                            shortest = d
                            nearest = head
                        end
                    end
                end
            end
        end
    end
    return nearest
end

-- 🔥 LOGIC MỚI: bắn viên đầu → xác định target → ghim liên tục khi giữ chuột
RunService.RenderStepped:Connect(function()
    if not aimbotActive then
        lockedTarget = nil
        AimStatus.Text = "Trạng thái: Tắt"
        return
    end

    local isFiring = UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1)
                or UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)

    if not isFiring then
        -- Thả chuột → giữ target cũ, KHÔNG reset
        -- Chỉ reset khi target chết hoặc biến mất
        if lockedTarget and (not lockedTarget.Parent or 
            (lockedTarget.Parent:FindFirstChildOfClass("Humanoid") and 
             lockedTarget.Parent:FindFirstChildOfClass("Humanoid").Health <= 0)) then
            lockedTarget = nil
        end
        return
    end

    -- 🔥 Khi giữ chuột: nếu chưa có target → tìm người gần tâm nhất (viên đạn đầu tiên)
    if not lockedTarget or not lockedTarget.Parent then
        lockedTarget = findNearestHead()
    end

    -- Ghim camera lên đầu target
    if lockedTarget and lockedTarget.Parent then
        local targetHum = lockedTarget.Parent:FindFirstChildOfClass("Humanoid")
        if not targetHum or targetHum.Health <= 0 then
            lockedTarget = findNearestHead()
        end
        if lockedTarget then
            local targetCF = CFrame.lookAt(Camera.CFrame.Position, lockedTarget.Position)
            if SMOOTH >= 1 then
                Camera.CFrame = targetCF
            else
                Camera.CFrame = Camera.CFrame:Lerp(targetCF, SMOOTH)
            end
            AimStatus.Text = "🔒 Đã khóa: " .. lockedTarget.Parent.Name
            AimStatus.TextColor3 = Color3.fromRGB(0, 255, 204)
        end
    else
        AimStatus.Text = "Trạng thái: Không có mục tiêu"
        AimStatus.TextColor3 = Color3.fromRGB(150, 150, 170)
    end
end)

