            Instance.new("UICorner", pBtn).CornerRadius = UDim.new(0, 5)
            
            -- Tên người chơi ở trên
            local nameLbl = Instance.new("TextLabel")
            nameLbl.Parent = pBtn
            nameLbl.BackgroundTransparency = 1
            nameLbl.Position = UDim2.new(0, 10, 0, 4)
            nameLbl.Size = UDim2.new(1, -50, 0, 18)
            nameLbl.Font = Enum.Font.GothamBold
            nameLbl.Text = p.Name
            nameLbl.TextColor3 = Color3.fromRGB(255, 255, 255)
            nameLbl.TextSize = 12
            nameLbl.TextXAlignment = Enum.TextXAlignment.Left
            
            -- ID Roblox nhỏ ở dưới
            local idLbl = Instance.new("TextLabel")
            idLbl.Parent = pBtn
            idLbl.BackgroundTransparency = 1
            idLbl.Position = UDim2.new(0, 10, 0, 20)
            idLbl.Size = UDim2.new(1, -50, 0, 16)
            idLbl.Font = Enum.Font.Gotham
