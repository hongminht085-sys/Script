-- Hệ thống ESP hiển thị tên, vị trí (khoảng cách) trực tiếp trên nhân vật
RunService.RenderStepped:Connect(function()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
            local char = p.Character
            local root = char.HumanoidRootPart
            local head = char:FindFirstChild("Head")
            
            -- Kiểm tra và tạo BillboardGui hiển thị Tên + Vị trí
            if espActive then
                if not char:FindFirstChild("VipESP_Tag") then
                    local bill = Instance.new("BillboardGui")
                    bill.Name = "VipESP_Tag"
                    bill.AlwaysOnTop = true
                    bill.Size = UDim2.new(0, 200, 0, 50)
                    bill.StudsOffset = Vector3.new(0, 2.5, 0)
                    
                    local txt = Instance.new("TextLabel")
                    txt.Name = "Info"
                    txt.Parent = bill
                    txt.BackgroundTransparency = 1
                    txt.Size = UDim2.new(1, 0, 1, 0)
                    txt.Font = Enum.Font.GothamBold
                    txt.TextSize = 12
                    txt.TextColor3 = Color3.fromRGB(0, 255, 204)
                    txt.TextStrokeTransparency = 0.5
                    
                    bill.Parent = char
                else
                    local bill = char:FindFirstChild("VipESP_Tag")
                    local txt = bill:FindFirstChild("Info")
                    if txt and head then
                        local dist = math.floor((root.Position - LocalPlayer.Character.HumanoidRootPart.Position).Magnitude)
                        txt.Text = p.Name .. "\n[Cách: " .. dist .. "m]"
                    end
                end
            else
                if char:FindFirstChild("VipESP_Tag") then
                    char.VipESP_Tag:Destroy()
                end
            end
        end
    end
end)

