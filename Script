local RedGui = Instance.new("ScreenGui", CoreGui)
RedGui.Name = "TuanMeoEmergencyRed"
RedGui.IgnoreGuiInset = true
local RedFrame = Instance.new("Frame", RedGui)
RedFrame.Size = UDim2.new(1, 0, 1, 0)
RedFrame.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
RedFrame.BackgroundTransparency = 1
RedFrame.BorderSizePixel = 0
RedFrame.ZIndex = 999

local isEscaping = false
local savedPosition = nil

RunService.RenderStepped:Connect(function()
    if not emergencyActive then 
        RedFrame.BackgroundTransparency = 1
        return 
    end
    
    pcall(function()
        local char = LocalPlayer.Character
        if not char then return end
        local hum = char:FindFirstChildOfClass("Humanoid")
        local root = char:FindFirstChild("HumanoidRootPart")
        if not hum or not root then return end
        
        local healthPercent = hum.Health / hum.MaxHealth
        if healthPercent <= 0.30 and healthPercent > 0 and not isEscaping then
            isEscaping = true
            savedPosition = root.CFrame
            for _, tool in ipairs(char:GetChildren()) do
                if tool:IsA("Tool") then tool.Parent = LocalPlayer.Backpack end
            end
            local skyPosition = savedPosition + Vector3.new(0, 150, 0)
            hum.PlatformStand = true
            root.Velocity = Vector3.new(0, 0, 0)
            root.CFrame = skyPosition * CFrame.Angles(math.rad(90), 0, 0)
        elseif isEscaping then
            RedFrame.BackgroundTransparency = 0.82
            root.Velocity = Vector3.new(0, 0, 0)
            root.CFrame = CFrame.new(root.Position.X, savedPosition.Y + 150, root.Position.Z) * CFrame.Angles(math.rad(90), 0, 0)
            if healthPercent >= 0.85 or hum.Health <= 0 then
                isEscaping = false
                hum.PlatformStand = false
                RedFrame.BackgroundTransparency = 1
                if savedPosition and root then root.CFrame = savedPosition end
            end
        else
            RedFrame.BackgroundTransparency = 1
        end
    end)
end)

