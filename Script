RunService.Stepped:Connect(function()
    pcall(function()
        local char = LocalPlayer.Character
        if char and char:FindFirstChild("HumanoidRootPart") then
            local root = char.HumanoidRootPart
            -- Lưu vị trí an toàn liên tục khi ở trên mặt đất
            if root.Position.Y > -50 then
                lastSafePosition = root.Position
            end
            
            -- Nếu kích hoạt và rớt xuống vực sâu (Y < -100)
            if antiVoidActive and root.Position.Y < -100 then
                root.CFrame = CFrame.new(lastSafePosition.X, lastSafePosition.Y + 5, lastSafePosition.Z)
                root.Velocity = Vector3.new(0, 0, 0)
            end
        end
    end)
end)

