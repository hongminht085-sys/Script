            root.Velocity = Vector3.new(0, 0, 0)
            root.CFrame = CFrame.new(root.Position.X, savedPosition.Y + 500, root.Position.Z)
            if healthPercent >= 0.85 or hum.Health <= 0 then
                isEscaping = false
                hum.PlatformStand = false
                if savedPosition and root then root.CFrame = savedPosition end
            end
        end
    end)
end)

