-- VÒNG LẶP XỬ LÝ CHÍNH (ĐÃ FIX TRIỆT ĐỂ)
--------------------------------------------------------------------------------
local lastSafePos = Vector3.new(0, 50, 0)

-- Vòng lặp vật lý (Noclip & Chống rơi vực vào Void thực thụ)
RunService.Stepped:Connect(function()
    pcall(function()
        local char = LocalPlayer.Character
        if not char then return end
        
        -- Xuyên tường (Nhảy & Ngồi)
        if noclipActive then
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") and part.CanCollide then
                    part.CanCollide = false
                end
            end
        end
        
        -- Chống rơi vực (Chỉ tele khi thực sự rơi xuống vực sâu Y < -150, không ảnh hưởng cửa hàng)
        local root = char:FindFirstChild("HumanoidRootPart")
        if root then
            if root.Position.Y > 0 then
                lastSafePos = root.Position
            elseif antiVoidActive and root.Position.Y < -150 then
                root.CFrame = CFrame.new(lastSafePos + Vector3.new(0, 5, 0))
                root.Velocity = Vector3.zero
            end
        end
    end)
end)

-- Vòng lặp khung hình (Tốc độ, Đấm/Bắn siêu nhanh, Aimbot khi bấm bắn, ESP)
RunService.RenderStepped:Connect(function()
    pcall(function()
        local char = LocalPlayer.Character
        local hum = char and char:FindFirstChild("Humanoid")
        local myRoot = char and char:FindFirstChild("HumanoidRootPart")
        
        -- 1. Chạy nhanh mượt mà
        if speedActive and hum then
            hum.WalkSpeed = customSpeed
        end
        
        -- 2. Đấm nhanh & Bắn nhanh (Gây sát thương thật bằng cách tăng tốc tool/remotes)
        if fastAttackActive and char then
            local tool = char:FindFirstChildOfClass("Tool")
            if tool then
                -- Kích hoạt liên tục tool để gây sát thương siêu nhanh
                pcall(function()
                    tool:Activate()
                end)
                for _, v in ipairs(tool:GetDescendants()) do
                    if v:IsA("NumberValue") or v:IsA("IntValue") then
                        local n = v.Name:lower()
                        if n:find("cooldown") or n:find("firerate") or n:find("delay") or n:find("speed") then
                            v.Value = math.max(0.001, v.Value / math.max(1, gunMultiplier))
                        end
                    end
                end
            end
            if hum then
                local animator = hum:FindFirstChildOfClass("Animator")
                if animator then
                    for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
                        track:AdjustSpeed(punchMultiplier)
                    end
                end
            end
        end
        
        -- 3. Aimbot (Chỉ ghim thẳng vào đầu ngay khoảnh khắc nhấn nút bắn / click chuột trái)
        if aimbotActive then
            local isFiring = UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) 
                          or UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)
            if isFiring then
                local closestHead = nil
                local minDist = math.huge
                local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
                
                for _, p in ipairs(Players:GetPlayers()) do
                    if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("Head") and p.Character:FindFirstChild("Humanoid") then
                        if p.Character.Humanoid.Health > 0 then
                            local head = p.Character.Head
                            local pos, onScreen = Camera:WorldToViewportPoint(head.Position)
                            if onScreen then
                                local dist = (Vector2.new(pos.X, pos.Y) - screenCenter).Magnitude
                                if dist < minDist then
                                    minDist = dist
                                    closestHead = head
                                end
                            end
                        end
                    end
                end
                
                if closestHead then
                    Camera.CFrame = CFrame.new(Camera.CFrame.Position, closestHead.Position)
                end
            end
        end
        
        -- 4. ESP Tên + Khoảng cách
        if espActive then
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") and p.Character:FindFirstChild("Head") then
                    local targetChar = p.Character
                    local targetRoot = targetChar.HumanoidRootPart
                    
                    local tag = targetChar:FindFirstChild("Vip_ESP")
                    if not tag then
                        tag = Instance.new("BillboardGui")
                        tag.Name = "Vip_ESP"
                        tag.AlwaysOnTop = true
                        tag.Size = UDim2.new(0, 140, 0, 30)
                        tag.StudsOffset = Vector3.new(0, 2.2, 0)
                        
                        local lbl = Instance.new("TextLabel", tag)
                        lbl.Name = "Lbl"
                        lbl.BackgroundTransparency = 1
                        lbl.Size = UDim2.new(1, 0, 1, 0)
                        lbl.Font = Enum.Font.GothamBold
                        lbl.TextSize = 11
                        lbl.TextColor3 = Color3.fromRGB(0, 255, 170)
                        lbl.TextStrokeTransparency = 0.2
                        tag.Parent = targetChar
                    end
                    local dist = myRoot and math.floor((targetRoot.Position - myRoot.Position).Magnitude) or 0
                    tag.Lbl.Text = p.Name .. " [" .. dist .. "m]"
                else
                    removeEsp(p)
                end
            end
        end
    end)
end)

-- 5. Bắn Xuyên Tường (Wallbang)
RunService.Heartbeat:Connect(function()
    if not wallbangActive then return end
    pcall(function()
        local rayParams = RaycastParams.new()
        rayParams.FilterDescendantsInstances = {LocalPlayer.Character}
        rayParams.FilterType = Enum.RaycastFilterType.Exclude
        
        local result = workspace:Raycast(Camera.CFrame.Position, Camera.CFrame.LookVector * 300, rayParams)
        if result and result.Instance and result.Instance:IsA("BasePart") then
            if not result.Instance.Parent:FindFirstChild("Humanoid") then
                result.Instance.CanQuery = false
            end
        end
    end)
end)
