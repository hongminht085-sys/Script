local isHitboxEnabled = false
local hitboxSize = 3
local originalData = {}

local function ResetAllHitboxes()
    for p, data in pairs(originalData) do
        if p and p.Character then
            pcall(function()
                if data.hrp and data.hrp.Parent then
                    data.hrp.Size = data.hrpSize
                    data.hrp.Transparency = data.hrpTrans
                    data.hrp.CanCollide = data.hrpCollide
                    data.hrp.Massless = data.hrpMassless
                end
            end)
        end
    end
    originalData = {}
end

