    if not speedAttackActive then return end
    pcall(function()
        local char = LocalPlayer.Character
        if char then
            for _, tool in ipairs(char:GetChildren()) do
                if tool:IsA("Tool") then
                    -- Tăng tốc độ animation tool (đấm/bắn nhanh hơn tùy chỉnh)
                    for _, anim in ipairs(tool:GetDescendants()) do
                        if anim:IsA("AnimationTrack") then
                            anim:AdjustSpeed(customPunchSpeed * 1.5)
                        end
                    end
                end
            end
        end
    end)
end)

