AimbotBtn.TextSize = 12
Instance.new("UICorner", AimbotBtn).CornerRadius = UDim.new(0, 6)

local aimbotActive = false
AimbotBtn.MouseButton1Click:Connect(function()
    aimbotActive = not aimbotActive
    AimbotBtn.BackgroundColor3 = aimbotActive and Color3.fromRGB(50, 200, 100) or Color3.fromRGB(200, 50, 50)
    AimbotBtn.Text = aimbotActive and "🎯 Aimbot Ghim Đầu: ĐANG BẬT" or "🎯 Aimbot Ghim Đầu: ĐANG TẮT"
end)

RunService.RenderStepped:Connect(function()
    if not aimbotActive then return end
    pcall(function()
        -- Kiểm tra xem người chơi có đang bấm nút bắn (Chuột trái hoặc Chuột phải) hay không
        local isFiring = UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) 
                      or UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)
        
        -- Nếu KHÔNG bắn thì hoàn toàn không ghim gì cả, để camera tự do
        if not isFiring then return end

        -- Khi BẮN: Lập tức quét và tìm người chơi gần tâm bắn nhất mà game đang ghim
        local nearestTarget = nil
        local shortestDist = math.huge
        local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
        
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("Head") and p.Character:FindFirstChild("Humanoid") then
                if p.Character.Humanoid.Health > 0 then
                    local head = p.Character.Head
                    local screenPoint, onScreen = Camera:WorldToViewportPoint(head.Position)
                    if onScreen then
                        local dist = (Vector2.new(screenPoint.X, screenPoint.Y) - screenCenter).Magnitude
                        -- Giới hạn tầm ngắm trong vòng tròn tâm bắn
                        if dist < shortestDist and dist < 250 then
                            shortestDist = dist
                            nearestTarget = head
                        end
                    end
                end
            end
        end
        
        -- Khóa thẳng tâm camera vào đầu mục tiêu ngay lập tức
        if nearestTarget then
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, nearestTarget.Position)
        end
    end)
end)

