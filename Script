local fovRadius = 150
FOVBox.FocusLost:Connect(function()
    local val = tonumber(FOVBox.Text:match("%d+"))
    if val then fovRadius = val FOVBox.Text = "Bán kính vòng tròn FOV: " .. val else FOVBox.Text = "Bán kính vòng tròn FOV: " .. fovRadius end
