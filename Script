            idLbl.TextColor3 = Color3.fromRGB(150, 150, 170)
            idLbl.TextSize = 10
            idLbl.TextXAlignment = Enum.TextXAlignment.Left
            
            -- Ảnh đại diện (Avatar) hiển thị bên cạnh
            pcall(function()
                local content = Players:GetUserThumbnailAsync(p.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size420x420)
                local img = Instance.new("ImageLabel")
