local function updatePlayerList()
    for _, child in ipairs(PlayerScroll:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end
    
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            local pBtn = Instance.new("TextButton")
            pBtn.Parent = PlayerScroll
            pBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 45)
            pBtn.Size = UDim2.new(1, 0, 0, 35)
            pBtn.Font = Enum.Font.Gotham
            pBtn.Text = "  " .. p.Name .. " (ID: " .. p.UserId .. ")"
            pBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
            pBtn.TextSize = 12
            pBtn.TextXAlignment = Enum.TextXAlignment.Left
            Instance.new("UICorner", pBtn).CornerRadius = UDim.new(0, 4)
            
            -- Hiển thị Avatar
            pcall(function()
                local content, isReady = Players:GetUserThumbnailAsync(p.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size420x420)
                local img = Instance.new("ImageLabel")
                img.Parent = pBtn
                img.BackgroundTransparency = 1
                img.Position = UDim2.new(1, -32, 0, 2)
                img.Size = UDim2.new(0, 31, 0, 31)
                img.Image = content
            end)

            pBtn.MouseButton1Click:Connect(function()
                selectedTarget = p
                for _, b in ipairs(PlayerScroll:GetChildren()) do
                    if b:IsA("TextButton") then b.BackgroundColor3 = Color3.fromRGB(30, 30, 45) end
                end
                pBtn.BackgroundColor3 = Color3.fromRGB(0, 150, 136)
            end)
        end
    end
    PlayerScroll.CanvasSize = UDim2.new(0, 0, 0, #Players:GetPlayers() * 40)
end

-- Tự động quét cập nhật danh sách liên tục khi có người vào/ra server
task.spawn(function()
    while true do
        updatePlayerList()
        task.wait(2)
    end
end)

