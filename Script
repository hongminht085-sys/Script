--------------------------------------------------------------------------------
local AimbotSection = Instance.new("Frame")
AimbotSection.Parent = Container
AimbotSection.BackgroundColor3 = Color3.fromRGB(25, 25, 35)
AimbotSection.Size = UDim2.new(1, 0, 0, 50)
