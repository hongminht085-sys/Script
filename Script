                        targetPart = obj:FindFirstChildWhichIsA("BasePart")
                    end
                    
                    if targetPart then
                        local sBtn = Instance.new("TextButton", ShopScroll)
                        sBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 42)
