        if p ~= LocalPlayer then
            local btn = Instance.new("TextButton", PlayerScroll)
            btn.BackgroundColor3 = (selectedTarget == p) and Color3.fromRGB(0, 160, 100) or Color3.fromRGB(30, 30, 42)
