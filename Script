local function scanShops()
    pcall(function()
        for _, child in ipairs(ShopScroll:GetChildren()) do
            if child:IsA("TextButton") then child:Destroy() end
        end
        
        local foundCount = 0
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("BasePart") or obj:IsA("Model") then
                local nameLower = obj.Name:lower()
                if nameLower:find("shop") or nameLower:find("store") or nameLower:find("vendor") or nameLower:find("buy") or nameLower:find("merchant") then
                    foundCount = foundCount + 1
                    local targetPart = obj:IsA("Model") and obj.PrimaryPart or obj
                    if not targetPart and obj:IsA("Model") then
                        targetPart = obj:FindFirstChildWhichIsA("BasePart")
                    end
                    
                    if targetPart then
                        local sBtn = Instance.new("TextButton", ShopScroll)
                        sBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 42)
                        sBtn.Size = UDim2.new(1, 0, 0, 32)
                        sBtn.Font = Enum.Font.GothamBold
                        sBtn.Text = "🏬 " .. obj.Name .. " (Bấm để Tele)"
                        sBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
                        sBtn.TextSize = 11
                        Instance.new("UICorner", sBtn).CornerRadius = UDim.new(0, 5)
                        
                        sBtn.MouseButton1Click:Connect(function()
                            pcall(function()
                                local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                                if myRoot then
                                    myRoot.CFrame = targetPart.CFrame * CFrame.new(0, 3, 0)
                                end
                            end)
                        end)
                    end
                end
            end
        end
        
        if foundCount == 0 then
            local emptyLbl = Instance.new("TextButton", ShopScroll)
            emptyLbl.BackgroundColor3 = Color3.fromRGB(30, 30, 42)
            emptyLbl.Size = UDim2.new(1, 0, 0, 32)
            emptyLbl.Font = Enum.Font.Gotham
            emptyLbl.Text = "⚠️ Không tìm thấy Shop nào trong map này!"
            emptyLbl.TextColor3 = Color3.fromRGB(255, 100, 100)
            emptyLbl.TextSize = 10
            Instance.new("UICorner", emptyLbl).CornerRadius = UDim.new(0, 5)
        end
        
        ShopScroll.CanvasSize = UDim2.new(0, 0, 0, math.max(#ShopScroll:GetChildren() * 35, 105))
    end)
end

