-- Render ESP dạng line cực gọn phong cách Free Fire
RunService.RenderStepped:Connect(function()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
            local char = p.Character
            local root = char.HumanoidRootPart
            local head = char:FindFirstChild("Head")
            
            if espActive then
                if not char:FindFirstChild("FF_ESP_Tag") then
                    local bill = Instance.new("BillboardGui")
                    bill.Name = "FF_ESP_Tag"
                    bill.AlwaysOnTop = true
                    bill.Size = UDim2.new(0, 150, 0, 40)
                    bill.StudsOffset = Vector3.new(0, 2.5, 0)
                    
                    local txt = Instance.new("TextLabel")
                    txt.Name = "Info"
                    txt.Parent = bill
                    txt.BackgroundTransparency = 1
                    txt.Size = UDim2.new(1, 0, 1, 0)
                    txt.Font = Enum.Font.GothamBold
                    txt.TextSize = 11
                    txt.TextColor3 = Color3.fromRGB(255, 50, 50) -- Màu đỏ nổi bật kiểu FF
                    txt.TextStrokeTransparency = 0.3
                    
                    bill.Parent = char
                else
                    local bill = char:FindFirstChild("FF_ESP_Tag")
                    local txt = bill:FindFirstChild("Info")
                    if txt and head and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                        local dist = math.floor((root.Position - LocalPlayer.Character.HumanoidRootPart.Position).Magnitude)
                        txt.Text = "⚡ " .. p.Name .. " [" .. dist .. "m]"
                    end
                end
            else
                if char:FindFirstChild("FF_ESP_Tag") then
                    char.FF_ESP_Tag:Destroy()
                end
            end
        end
